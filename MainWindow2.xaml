<Window x:Class="RockoBoy_Run.MainWindow2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RockoBoy_Run"
        mc:Ignorable="d"
        Title="RockoBoy_Run" Height="720" Width="1280" Icon="/Rocko_Icono.png" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <!-- Canvas: Se utiliza para colocar elementos mediante el uso de coordenadas -->
    <Canvas Name="myCanvas" Focusable="True" KeyDown="KeyIsDown" KeyUp="KeyIsUp" Background="LightBlue" >
        <Rectangle Name="city2" Height="720" Width="2300" Fill="LightGreen" Canvas.Left="2299" />
        <Rectangle Name="city1" Height="720" Width="2300" Fill="Orange" Canvas.Left="0" />

        <Rectangle Name="street1" Height="191" Width="1300" Fill="Gray" Canvas.Top="529"  Canvas.Left="0"/>
        <Rectangle Name="street2" Height="191" Width="1300" Fill="DimGray" Canvas.Top="529"  Canvas.Left="1280"/>
        <Rectangle Name="street3" Height="100" Width="160" Fill="Transparent" Canvas.Top="585"  Canvas.Left="120"/>

        <Rectangle Name="rocko" Height="145" Width="126" Fill="Red" Canvas.Top="442" Canvas.Left="132" />

        <Rectangle Name="enemy1" Height="203" Width="205" Fill="Blue" Canvas.Top="383" Canvas.Left="1600"/>
        <Rectangle Name="enemy3" Height="100" Width="100" Fill="Pink" Canvas.Top="375" Canvas.Left="1300"/>

        <Label Name="scoreText" FontSize="50" FontWeight="Normal"  FontFamily="Retro Gaming" Content="Time: 00:00:00" Canvas.Left="820" />

        <Image Name="screen2" Source="/Assets/Start/Screen_2.png" Height="302" Width="404" Canvas.Top="203" Canvas.Left="440"/>
        <Button x:Name="restart" Height="35" Width="210" Canvas.Top="300" Canvas.Left="545" Click="Restart_Click" BorderBrush="{x:Null}">
            <Button.Background>
                <ImageBrush Stretch="Uniform" ImageSource="/Assets/Start/Restart.png"/>
            </Button.Background>
        </Button>
        <Button x:Name="backStart" Height="36" Width="142" Canvas.Top="400" Canvas.Left="550" Click="backStart_Click" BorderBrush="{x:Null}">
            <Button.Background>
                <ImageBrush ImageSource="/Assets/Start/Back.png" Stretch="Uniform"/>
            </Button.Background>
        </Button>

    </Canvas>
</Window>
