<Window x:Class="RockoBoy_Run.Start"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:local="clr-namespace:RockoBoy_Run" 
        mc:Ignorable="d" 
        Title="RockoBoy_Run" Height="720" Width="1280" Icon="/Assets/Start/Rocko_Icono.png" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Canvas>
        <Image Name="startMenu" Source="Assets/Start/Start_Menu.png" Height="720" Width="1280"/>
        <Image Name="screen1" Source="Assets/Start/Screen_1.png" Height="412" Width="384" Canvas.Left="815" Canvas.Top="188" Stretch="Fill" />
        <Button Name="StartGame" Height="37" Width="147" Canvas.Top="212" Canvas.Left="924" Click="StartGame_Click" BorderBrush="{x:Null}">
            <Button.Background>
                <ImageBrush ImageSource="Assets/Start/Start.png" Stretch="Uniform"/>
            </Button.Background>
        </Button>
        <Button Name="HowToPlay" Height="44" Width="343" Canvas.Top="315" Canvas.Left="835" Click="HowToPlay_Click" BorderBrush="{x:Null}">
            <Button.Background>
                <ImageBrush ImageSource="Assets/Start/HowToPlay.png" Stretch="Uniform"/>
            </Button.Background>
        </Button>
        <Button Name="btn_Records" Height="44" Width="343" Canvas.Top="415" Canvas.Left="835" Click="btn_Records_Click" BorderBrush="{x:Null}" >
            <Button.Background>
                <ImageBrush ImageSource="Assets/Start/Records.png" Stretch="Uniform"/>
            </Button.Background>
        </Button>
        <Button Name="Exit" Height="35" Width="109" Canvas.Top="510" Canvas.Left="943" Click="Exit_Click" BorderBrush="{x:Null}">
            <Button.Background>
                <ImageBrush ImageSource="Assets/Start/Exit.png" Stretch="Uniform"/>
            </Button.Background>
        </Button>
    </Canvas>
</Window>